# Tokyo HL gateway/executor node (.env)
# Runs remote HL quote/execution service.

DRY_RUN=false
HL_EXEC_MODE=local
HL_DATA_MODE=local

# HL signer key: choose one option below.
# Option A: plain private key in env (less secure)
HL_API_WALLET_PRIVATE_KEY=0x...
# Option B: AWS Secrets Manager (recommended)
# HL_API_WALLET_SECRET_ID=hlp-eb65
# AWS_REGION=ap-northeast-1

HL_WALLET_ADDRESS=0x...
HL_DEX=xyz

# Gateway ports and self-heal
HL_QUOTE_WS_PORT=18081
HL_QUOTE_WS_PUSH_SEC=0.4
HL_QUOTE_SYMBOL=SILVER
HL_SELF_HEAL_RESTART_SEC=180
