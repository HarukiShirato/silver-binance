# Hyperliquid signer (recommended: API wallet private key, not main wallet key)
HL_API_WALLET_PRIVATE_KEY=your_api_wallet_private_key_here
HL_WALLET_ADDRESS=0x...
HL_DEX=xyz
DRY_RUN=false


# CTP (国贸期货) - 仿真/实盘账号
CTP_USER_ID=your_ctp_user_id
CTP_PASSWORD=your_ctp_password
CTP_AUTH_CODE=your_auth_code
CTP_MD_FRONT=tcp://114.80.225.10:41213
CTP_TD_FRONT=tcp://114.80.225.10:41205
CTP_MD_FRONT_BACKUPS=tcp://140.206.244.75:41213,tcp://140.206.244.67:41213,tcp://114.80.225.2:41213
CTP_TD_FRONT_BACKUPS=tcp://140.206.244.75:41205,tcp://140.206.244.67:41205,tcp://114.80.225.2:41205

# Feishu Webhook
# Trade/heartbeat/error notifications
FEISHU_TRADE_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# Margin warnings dedicated webhook (optional, falls back to trade webhook if empty)
FEISHU_MARGIN_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/
# backward compatibility:
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
